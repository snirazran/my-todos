<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/quick_add_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/quick_add_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_quick_add_title"
        android:textColor="@color/quick_add_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_add_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:importantForAutofill="no"
        android:background="@drawable/quick_add_field"
        android:hint="@string/widget_quick_add_hint"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="textCapSentences|textAutoCorrect"
        android:maxLength="200"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/quick_add_text"
        android:textColorHint="@color/quick_add_text_muted"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/quick_add_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/widget_quick_add_cancel"
            android:textColor="@color/quick_add_text_muted" />

        <Button
            android:id="@+id/quick_add_save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/quick_add_button"
            android:minWidth="96dp"
            android:text="@string/widget_quick_add_save"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
